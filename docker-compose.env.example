# Produktions-Konfiguration für docker-compose.yml.
# Auf dem Server nach `.env` kopieren (bleibt dort, wird nie committet):
#   cp docker-compose.env.example .env
# und dann die Platzhalter unten ersetzen.

# Öffentliche URL, unter der das Buch erreichbar ist (Reverse Proxy terminiert TLS).
ORIGIN=https://digifriends.nichtregistriert.de

# Port, auf dem der App-Container auf dem Host lauscht (Reverse Proxy zeigt hierauf).
APP_PORT=7066

# Bücher anlegen: open = fuer alle, closed = gesperrt.
SIGNUP_MODE=open

# Zufalls-Pepper fuer Token-/Passwort-Hashing. Erzeugen mit z. B.:
#   openssl rand -base64 32
SECRET_PEPPER=change-me

# Passwort fuer den Postgres-Benutzer "digifriends". Erzeugen mit z. B.:
#   openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Passwort fuer den Betreiber-Bereich (/betreiber: Buecher einsehen/sperren,
# Statistik, Verlauf). Erzeugen mit z. B.: openssl rand -base64 18
OPERATOR_PASSWORD=change-me

# Ab wann ein Buch im Betreiber-Bereich als "Inaktiv" markiert wird (reiner
# Hinweis, keine automatische Loeschung).
INACTIVE_AFTER_DAYS=365

# Obergrenzen fuer Bild-Uploads (Bytes / Anzahl je Eintrag - die
# Eintragen-Ansicht zeigt entsprechend 4 feste Plaetze fuer Fotos/Zeichnungen).
MAX_UPLOAD_BYTES=8388608
MAX_PHOTOS_PER_ENTRY=4
MAX_DRAWINGS_PER_ENTRY=4
BODY_SIZE_LIMIT=12000000

# Mailversand (optional). Ohne SMTP_URL bleibt die E-Mail-Wiederherstellung
# im UI ausgeblendet.
# SMTP_URL=smtp://user:pass@smtp.eu-anbieter.example:587
# MAIL_FROM="Freundebuch <noreply@digifriends.nichtregistriert.de>"

# Wie viele Tage taegliche Datenbank-/Uploads-Sicherungen aufbewahrt werden
# (siehe Service "backup" in docker-compose.yml, landet unter ./backups).
BACKUP_KEEP_DAYS=14

# ntfy-Push-Benachrichtigungen (optional): volle Topic-URL. Ohne NTFY_URL
# passiert nichts. Nur setzen, wenn der ntfy-Server Auth verlangt:
# NTFY_TOKEN=...
NTFY_URL=https://ntfy.nichtregistriert.de/digifriends-326665d99376
