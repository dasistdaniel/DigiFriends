# --- Datenbank ---------------------------------------------------------------
# Lokal (Standard): eingebettetes PGlite, keine Installation nötig.
DATABASE_URL="pglite://.pgdata"
# Produktion: echtes PostgreSQL, z. B.
# DATABASE_URL="postgres://digifriends:secret@db:5432/digifriends"

# --- App --------------------------------------------------------------------
# Öffentliche Basis-URL (für generierte Buch-Links in E-Mails etc.)
ORIGIN="http://localhost:5173"
# Buch-Erstellung: open = jede:r darf Bücher anlegen, closed = gesperrt
SIGNUP_MODE="open"
# Zufalls-Pepper für Token-/Passwort-Hashing (in Produktion setzen!)
SECRET_PEPPER="dev-only-change-me"

# --- Uploads (optional, Standardwerte reichen meist) ------------------------
# Verzeichnis für hochgeladene Bilder (lokal ein Ordner, in Produktion ein Volume).
# UPLOAD_DIR=".uploads"
# Obergrenzen je Bild/Eintrag.
# MAX_UPLOAD_BYTES=8388608
# MAX_PHOTOS_PER_ENTRY=6
# MAX_DRAWINGS_PER_ENTRY=4

# --- Mailversand (optional, nur für Admin-Wiederherstellung) ----------------
# Ohne SMTP-Konfiguration wird die E-Mail-Wiederherstellung im UI ausgeblendet.
# SMTP_URL="smtp://user:pass@smtp.eu.example.com:587"
# MAIL_FROM="Freundebuch <noreply@example.com>"

# --- Betreiber-Bereich (/betreiber) ------------------------------------------
# Ohne gesetztes Passwort ist der Betreiber-Bereich deaktiviert.
# OPERATOR_PASSWORD="change-me"

# --- Reverse Proxy (in docker-compose.yml fest gesetzt) ----------------------
# ADDRESS_HEADER=x-forwarded-for / XFF_DEPTH=1 sagen adapter-node, die echte
# Besucher-IP aus X-Forwarded-For zu lesen statt der Proxy-IP - Voraussetzung
# fuers IP-basierte Rate-Limiting (rateLimit.ts). Setzt einen einzelnen
# vertrauenswuerdigen Reverse-Proxy-Hop davor voraus (Standard-Setup). Laeuft
# die App direkt ohne Proxy (z. B. lokal), bleiben diese Variablen einfach
# ungesetzt/leer.
